<%- include('../partials/header', {
  pageTitle: 'My Route',
  pageCss: ['live-tracking']
}) %>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<div class="app-shell">

  <%- include('../partials/sidebar', {
    currentPage: 'route-map'
  }) %>

  <%- include('../partials/navbar', {
    pageLabel: 'My Route'
  }) %>

  <div class="app-main">
    <main class="main-content">

      <h3 class="mb-3">My Route</h3>

      <% if (!bus) { %>

        <div class="card p-4 text-center text-muted">
          No bus has been assigned to you yet. Please contact the administration.
        </div>

      <% } else if (!route) { %>

        <div class="card p-4 text-center text-muted">
          Your bus doesn't have a route assigned yet. Please check back later.
        </div>

      <% } else { %>

        <div class="row g-3 mb-3">
          <div class="col-md-3">
            <div class="card p-3 h-100">
              <div class="text-muted small text-uppercase mb-1">Bus</div>
              <strong><%= bus.bus_number %></strong>
            </div>
          </div>
          <div class="col-md-3">
            <div class="card p-3 h-100">
              <div class="text-muted small text-uppercase mb-1">Driver</div>
              <strong><%= bus.driver_name || 'Not assigned yet' %></strong>
            </div>
          </div>
          <div class="col-md-3">
            <div class="card p-3 h-100">
              <div class="text-muted small text-uppercase mb-1">Distance</div>
              <strong><%= route.total_distance ? route.total_distance + ' km' : '—' %></strong>
            </div>
          </div>
          <div class="col-md-3">
            <div class="card p-3 h-100">
              <div class="text-muted small text-uppercase mb-1">Est. Journey Time</div>
              <strong><%= route.estimated_time ? route.estimated_time + ' min' : '—' %></strong>
            </div>
          </div>
        </div>

        <div class="card p-3 mb-3">
          <h5 class="mb-1"><%= route.route_name %></h5>
          <p class="text-muted mb-0"><%= route.start_location %> &rarr; <%= route.end_location %></p>
        </div>

        <div class="row g-3">
          <div class="col-lg-7">
            <div id="routeMap" data-stops='<%= JSON.stringify(stops) %>'></div>
          </div>
          <div class="col-lg-5">
            <div class="card p-3">
              <h5 class="mb-3">Stops</h5>
              <% if (stops.length === 0) { %>
                <p class="text-muted mb-0">No stops added for this route yet.</p>
              <% } else { %>
                <ol class="ps-3 mb-0">
                  <% stops.forEach((stop) => { %>
                    <li class="mb-2">
                      <strong><%= stop.stop_name %></strong>
                      <% if (stop.expected_arrival) { %>
                        <span class="text-muted small"> &middot; <%= String(stop.expected_arrival).slice(0, 5) %></span>
                      <% } %>
                    </li>
                  <% }) %>
                </ol>
              <% } %>
            </div>
          </div>
        </div>

        <a href="/student/track-bus" class="btn btn-primary mt-3">Track My Bus Live</a>

      <% } %>

    </main>

    <%- include('../partials/footer') %>

  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/script.js"></script>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="/js/route-map.js"></script>

</body>
</html>