<%- include('../partials/header', {
  pageTitle: 'Live Location',
  pageCss: []
}) %>

<head> <link
  rel="stylesheet"
  href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
/>

<style>
  #map {
    width: 100%;
    height: 500px;
    border-radius: 15px;
    overflow: hidden;
    z-index: 1;
  }

  .location-card {
    border-radius: 15px;
  }
</style></head>
<div class="app-shell">

  <%- include('../partials/sidebar', {
    currentPage: 'live-location'
  }) %>

  <%- include('../partials/navbar', {
    pageLabel: 'Live Location'
  }) %>

  <div class="app-main">

    <main class="main-content">

      <!-- PAGE HEADER -->
      <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
          <h3 class="mb-1">
            <i class="bi bi-geo-alt-fill text-primary"></i>
            Live Bus Location
          </h3>

          <p class="text-muted mb-0">
            Share your current GPS location with students and administrators.
          </p>
        </div>

        <div>
          <span id="connectionStatus" class="badge bg-secondary">
            Connecting...
          </span>
        </div>

      </div>


      <!-- BUS INFORMATION -->
      <div class="row g-3 mb-3">

        <div class="col-md-4">

          <div class="card p-4 h-100">

            <h5>
              <i class="bi bi-bus-front-fill text-primary"></i>
              My Bus
            </h5>

            <hr>

            <% if (bus) { %>

              <p class="mb-2">
                <strong>Bus Number:</strong>
                <%= bus.bus_number %>
              </p>

              <p class="mb-2">
                <strong>Route:</strong>
                <%= bus.route_name || 'Not assigned' %>
              </p>

              <p class="mb-0">
                <strong>Trip Status:</strong>

                <span id="tripStatus"
                      class="badge <%= bus.status === 'active' ? 'bg-success' : 'bg-secondary' %>">

                  <%= bus.status === 'active' ? 'Active' : 'Not Started' %>

                </span>
              </p>

            <% } else { %>

              <div class="alert alert-warning mb-0">
                No bus is assigned to you.
              </div>

            <% } %>

          </div>

        </div>


        <!-- GPS STATUS -->
        <div class="col-md-4">

          <div class="card p-4 h-100">

            <h5>
              <i class="bi bi-crosshair text-success"></i>
              GPS Status
            </h5>

            <hr>

            <p class="mb-2">
              <strong>Status:</strong>
              <span id="gpsStatus" class="badge bg-secondary">
                Waiting
              </span>
            </p>

            <p class="mb-2">
              <strong>Latitude:</strong>
              <span id="latitude">—</span>
            </p>

            <p class="mb-2">
              <strong>Longitude:</strong>
              <span id="longitude">—</span>
            </p>

            <p class="mb-0">
              <strong>Speed:</strong>
              <span id="speed">0</span> km/h
            </p>

          </div>

        </div>


        <!-- LAST UPDATE -->
        <div class="col-md-4">

          <div class="card p-4 h-100">

            <h5>
              <i class="bi bi-clock-history text-warning"></i>
              Last Update
            </h5>

            <hr>

            <p id="lastUpdate" class="fs-5 mb-3">
              No location sent yet.
            </p>

            <p class="text-muted mb-0">
              Your location is automatically sent while the trip is running.
            </p>

          </div>

        </div>

      </div>


      <!-- CONTROL PANEL -->
      <div class="card p-4 mb-3">

        <h5>
          <i class="bi bi-broadcast text-danger"></i>
          Location Sharing
        </h5>

        <hr>

        <% if (bus) { %>

          <div id="locationMessage"
               class="alert alert-info">

            Click <strong>Start Location Sharing</strong>
            to begin sending your GPS location.

          </div>

          <div class="d-flex gap-2 flex-wrap">

            <button
              id="startLocationBtn"
              class="btn btn-success">

              <i class="bi bi-play-fill"></i>
              Start Location Sharing

            </button>

            <button
              id="stopLocationBtn"
              class="btn btn-danger"
              disabled>

              <i class="bi bi-stop-fill"></i>
              Stop Location Sharing

            </button>

          </div>

        <% } else { %>

          <div class="alert alert-warning mb-0">

            You cannot share a location because no bus is assigned to you.

          </div>

        <% } %>

      </div>


      <!-- MAP -->
      <div class="card p-4">

        <div class="d-flex justify-content-between align-items-center mb-3">

          <h5 class="mb-0">

            <i class="bi bi-map text-primary"></i>
            Current GPS Position

          </h5>

          <span id="mapStatus"
                class="text-muted">

            Waiting for GPS...

          </span>

        </div>

        <div
          id="map"
          style="
            width: 100%;
            height: 450px;
            border-radius: 12px;
            background: #eef2f7;
            display: flex;
            align-items: center;
            justify-content: center;
          "
        >

          <div class="text-center text-muted">

            <i class="bi bi-geo-alt fs-1"></i>

            <p class="mt-2 mb-0">
              Your GPS location will appear here.
            </p>

          </div>

        </div>

      </div>

    </main>

    <%- include('../partials/footer') %>

  </div>

</div>


<!-- SOCKET.IO -->
<!-- Leaflet JS -->
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<!-- Socket.IO -->
<script src="/socket.io/socket.io.js"></script>

<script>

const busId = <%= bus ? bus.id : 'null' %>;

const initialLatitude =
  <%= location ? Number(location.latitude) : 'null' %>;

const initialLongitude =
  <%= location ? Number(location.longitude) : 'null' %>;


// ======================================================
// MAP VARIABLES
// ======================================================

let map = null;

let busMarker = null;


// ======================================================
// INITIALIZE MAP
// ======================================================

if (busId) {

  // Default Pune location
  const defaultLatitude = 18.5204;

  const defaultLongitude = 73.8567;


  // Use existing GPS position
  // if available

  const mapLatitude =
    initialLatitude !== null
      ? initialLatitude
      : defaultLatitude;


  const mapLongitude =
    initialLongitude !== null
      ? initialLongitude
      : defaultLongitude;


  // Create Leaflet map

  map = L.map('map').setView(
    [
      mapLatitude,
      mapLongitude
    ],
    15
  );


  // OpenStreetMap

  L.tileLayer(
    'https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',
    {
      maxZoom: 19,

      attribution:
        '&copy; OpenStreetMap contributors'
    }
  ).addTo(map);


  // If GPS position exists
  // create marker

  if (
    initialLatitude !== null &&
    initialLongitude !== null
  ) {

    createBusMarker(
      initialLatitude,
      initialLongitude
    );

  }


  // Fix Bootstrap rendering

  setTimeout(() => {

    map.invalidateSize();

  }, 500);

}


// ======================================================
// SOCKET.IO
// ======================================================

const socket = io();


// ======================================================
// SOCKET CONNECTED
// ======================================================

socket.on(
  'connect',
  () => {

    console.log(
      '✅ Driver connected to tracking server'
    );

  }
);


// ======================================================
// SOCKET DISCONNECTED
// ======================================================

socket.on(
  'disconnect',
  () => {

    console.log(
      '❌ Driver disconnected from tracking server'
    );

  }
);


// ======================================================
// LIVE LOCATION UPDATE
// ======================================================

socket.on(
  'bus-location-update',
  (data) => {

    console.log(
      '📍 Driver GPS update:',
      data
    );


    // Only update driver's own bus

    if (
      Number(data.bus_id) !==
      Number(busId)
    ) {

      return;

    }


    // Update GPS text

    updateLocation(

      data.latitude,

      data.longitude,

      data.speed,

      data.updated_at

    );


    // Update map

    updateBusMarker(

      Number(data.latitude),

      Number(data.longitude)

    );

  }
);


// ======================================================
// CREATE BUS MARKER
// ======================================================

function createBusMarker(
  latitude,
  longitude
) {

  if (!map) {

    return;

  }


  busMarker = L.marker(
    [
      latitude,
      longitude
    ]
  )
  .addTo(map);


  busMarker.bindPopup(

    `
      <div style="text-align:center">

        <strong>
          🚌 Your Bus
        </strong>

        <br>

        Bus ID:
        ${busId}

        <br>

        <small>
          Your Current GPS Position
        </small>

      </div>
    `

  );


  busMarker.openPopup();


  console.log(
    '🚌 Driver bus marker created:',
    latitude,
    longitude
  );

}


// ======================================================
// UPDATE BUS MARKER
// ======================================================

function updateBusMarker(
  latitude,
  longitude
) {

  if (!map) {

    return;

  }


  // Create marker
  // if it doesn't exist

  if (!busMarker) {

    createBusMarker(
      latitude,
      longitude
    );

    return;

  }


  // Move marker

  busMarker.setLatLng(

    [
      latitude,
      longitude
    ]

  );


  // Center map

  map.panTo(

    [
      latitude,
      longitude
    ]

  );


  // Update popup

  busMarker.setPopupContent(

    `
      <div style="text-align:center">

        <strong>
          🚌 Your Bus
        </strong>

        <br>

        Bus ID:
        ${busId}

        <br>

        <small>
          GPS Location Updating Live
        </small>

      </div>
    `

  );


  console.log(
    '📍 Driver map updated:',
    latitude,
    longitude
  );

}


// ======================================================
// UPDATE GPS INFORMATION
// ======================================================

function updateLocation(
  latitude,
  longitude,
  speed,
  updatedAt
) {


  const latitudeElement =
    document.getElementById(
      'latitude'
    );


  const longitudeElement =
    document.getElementById(
      'longitude'
    );


  const speedElement =
    document.getElementById(
      'speed'
    );


  const updatedAtElement =
    document.getElementById(
      'updatedAt'
    );


  if (latitudeElement) {

    latitudeElement.textContent =
      Number(latitude).toFixed(6);

  }


  if (longitudeElement) {

    longitudeElement.textContent =
      Number(longitude).toFixed(6);

  }


  if (
    speedElement &&
    speed !== null &&
    speed !== undefined
  ) {

    speedElement.textContent =
      speed + ' km/h';

  }


  if (
    updatedAtElement &&
    updatedAt
  ) {

    updatedAtElement.textContent =
      updatedAt;

  }

}

</script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script src="/js/script.js"></script>

</body>
</html>