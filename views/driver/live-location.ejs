<%- include('../partials/header', {
  pageTitle: 'Live Location',
  pageCss: []
}) %>

<head> <link
  rel="stylesheet"
  href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
/>

<style>
  #map {
    width: 100%;
    height: 500px;
    border-radius: 15px;
    overflow: hidden;
    z-index: 1;
  }

  .location-card {
    border-radius: 15px;
  }
</style></head>
<div class="app-shell">

  <%- include('../partials/sidebar', {
    currentPage: 'live-location'
  }) %>

  <%- include('../partials/navbar', {
    pageLabel: 'Live Location'
  }) %>

  <div class="app-main">

    <main class="main-content">

      <!-- PAGE HEADER -->
      <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
          <h3 class="mb-1">
            <i class="bi bi-geo-alt-fill text-primary"></i>
            Live Bus Location
          </h3>

          <p class="text-muted mb-0">
            Share your current GPS location with students and administrators.
          </p>
        </div>

        <div>
          <span id="connectionStatus" class="badge bg-secondary">
            Connecting...
          </span>
        </div>

      </div>


      <!-- BUS INFORMATION -->
      <div class="row g-3 mb-3">

        <div class="col-md-4">

          <div class="card p-4 h-100">

            <h5>
              <i class="bi bi-bus-front-fill text-primary"></i>
              My Bus
            </h5>

            <hr>

            <% if (bus) { %>

              <p class="mb-2">
                <strong>Bus Number:</strong>
                <%= bus.bus_number %>
              </p>

              <p class="mb-2">
                <strong>Route:</strong>
                <%= bus.route_name || 'Not assigned' %>
              </p>

              <p class="mb-0">
                <strong>Trip Status:</strong>

                <span id="tripStatus"
                      class="badge <%= bus.status === 'active' ? 'bg-success' : 'bg-secondary' %>">

                  <%= bus.status === 'active' ? 'Active' : 'Not Started' %>

                </span>
              </p>

            <% } else { %>

              <div class="alert alert-warning mb-0">
                No bus is assigned to you.
              </div>

            <% } %>

          </div>

        </div>


        <!-- GPS STATUS -->
        <div class="col-md-4">

          <div class="card p-4 h-100">

            <h5>
              <i class="bi bi-crosshair text-success"></i>
              GPS Status
            </h5>

            <hr>

            <p class="mb-2">
              <strong>Status:</strong>
              <span id="gpsStatus" class="badge bg-secondary">
                Waiting
              </span>
            </p>

            <p class="mb-2">
              <strong>Latitude:</strong>
              <span id="latitude">—</span>
            </p>

            <p class="mb-2">
              <strong>Longitude:</strong>
              <span id="longitude">—</span>
            </p>

            <p class="mb-0">
              <strong>Speed:</strong>
              <span id="speed">0</span> km/h
            </p>

          </div>

        </div>


        <!-- LAST UPDATE -->
        <div class="col-md-4">

          <div class="card p-4 h-100">

            <h5>
              <i class="bi bi-clock-history text-warning"></i>
              Last Update
            </h5>

            <hr>

            <p id="lastUpdate" class="fs-5 mb-3">
              No location sent yet.
            </p>

            <p class="text-muted mb-0">
              Your location is automatically sent while the trip is running.
            </p>

          </div>

        </div>

      </div>


      <!-- CONTROL PANEL -->
      <div class="card p-4 mb-3">

        <h5>
          <i class="bi bi-broadcast text-danger"></i>
          Location Sharing
        </h5>

        <hr>

        <% if (bus) { %>

          <div id="locationMessage"
               class="alert alert-info">

            Click <strong>Start Location Sharing</strong>
            to begin sending your GPS location.

          </div>

          <div class="d-flex gap-2 flex-wrap">

            <button
              id="startLocationBtn"
              class="btn btn-success">

              <i class="bi bi-play-fill"></i>
              Start Location Sharing

            </button>

            <button
              id="stopLocationBtn"
              class="btn btn-danger"
              disabled>

              <i class="bi bi-stop-fill"></i>
              Stop Location Sharing

            </button>

          </div>

        <% } else { %>

          <div class="alert alert-warning mb-0">

            You cannot share a location because no bus is assigned to you.

          </div>

        <% } %>

      </div>


      <!-- MAP -->
      <div class="card p-4">

        <div class="d-flex justify-content-between align-items-center mb-3">

          <h5 class="mb-0">

            <i class="bi bi-map text-primary"></i>
            Current GPS Position

          </h5>

          <span id="mapStatus"
                class="text-muted">

            Waiting for GPS...

          </span>

        </div>

        <div
          id="map"
          style="
            width: 100%;
            height: 450px;
            border-radius: 12px;
            background: #eef2f7;
            display: flex;
            align-items: center;
            justify-content: center;
          "
        >

          <div class="text-center text-muted">

            <i class="bi bi-geo-alt fs-1"></i>

            <p class="mt-2 mb-0">
              Your GPS location will appear here.
            </p>

          </div>

        </div>

      </div>

    </main>

    <%- include('../partials/footer') %>

  </div>

</div>


<!-- SOCKET.IO -->
 <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="/socket.io/socket.io.js"></script>

<script>
document.addEventListener('DOMContentLoaded', function () {

    const startBtn =
        document.getElementById('startLocationBtn');

    const stopBtn =
        document.getElementById('stopLocationBtn');

    const statusText =
        document.getElementById('gpsStatus');

    const latitudeText =
        document.getElementById('latitude');

    const longitudeText =
        document.getElementById('longitude');

    const speedText =
        document.getElementById('speed');

    const lastUpdateText =
        document.getElementById('lastUpdate');

    let watchId = null;

    // -----------------------------------------
// LEAFLET MAP
// -----------------------------------------

let map = null;
let busMarker = null;

// Default map position
const defaultLat = 18.5204;
const defaultLng = 73.8567;

// Initialize map
if (document.getElementById('map')) {

    map = L.map('map').setView(
        [defaultLat, defaultLng],
        13
    );

    L.tileLayer(
        'https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',
        {
            maxZoom: 19,
            attribution:
                '&copy; OpenStreetMap contributors'
        }
    ).addTo(map);

}

    // -----------------------------------------
    // START LOCATION SHARING
    // -----------------------------------------

    if (startBtn) {

        startBtn.addEventListener('click', function () {

            if (!navigator.geolocation) {

                alert(
                    'Geolocation is not supported by your browser.'
                );

                return;

            }

            statusText.textContent =
                'Requesting GPS permission...';

            startBtn.disabled = true;

            navigator.geolocation.getCurrentPosition(

                function (position) {

                    console.log(
                        'GPS permission granted'
                    );

                    statusText.textContent =
                        'GPS Online';

                    startGPS();

                },

                function (error) {

                    console.error(
                        'GPS permission error:',
                        error
                    );

                    startBtn.disabled = false;

                    statusText.textContent =
                        'GPS Error';

                    alert(
                        'Unable to access GPS. Please allow location permission in your browser.'
                    );

                },

                {
                    enableHighAccuracy: true,
                    timeout: 15000,
                    maximumAge: 0
                }

            );

        });

    }


    // -----------------------------------------
    // START GPS WATCHER
    // -----------------------------------------

    function startGPS() {

        if (watchId !== null) {

            navigator.geolocation.clearWatch(
                watchId
            );

        }

        statusText.textContent =
            'GPS Starting...';

        watchId =
            navigator.geolocation.watchPosition(

                function (position) {

                    const latitude =
                        position.coords.latitude;

                    const longitude =
                        position.coords.longitude;

                        // -----------------------------------------
// UPDATE DRIVER MAP
// -----------------------------------------

if (map) {

    const gpsPosition = [
        latitude,
        longitude
    ];

    // First GPS update
    if (!busMarker) {

        busMarker = L.marker(
            gpsPosition
        )
        .addTo(map)
        .bindPopup(
            '<strong>Your Bus</strong><br>Current GPS Position'
        )
        .openPopup();

    }

    // Move existing marker
    else {

        busMarker.setLatLng(
            gpsPosition
        );

    }

    // Center map on bus
    map.setView(
        gpsPosition,
        16
    );

    // Update map status
    const mapStatus =
        document.getElementById('mapStatus');

    if (mapStatus) {

        mapStatus.textContent =
            'GPS Online';

    }

}

                    const speed =
                        position.coords.speed
                            ? position.coords.speed * 3.6
                            : 0;


                    console.log(
                        'GPS position:',
                        latitude,
                        longitude,
                        speed
                    );


                    // Update UI

                    if (latitudeText) {

                        latitudeText.textContent =
                            latitude.toFixed(6);

                    }

                    if (longitudeText) {

                        longitudeText.textContent =
                            longitude.toFixed(6);

                    }

                    if (speedText) {

                        speedText.textContent =
                            speed.toFixed(1) + ' km/h';

                    }

                    if (lastUpdateText) {

                        lastUpdateText.textContent =
                            new Date().toLocaleTimeString();

                    }

                    statusText.textContent =
                        'GPS Online';


                    // -----------------------------------------
                    // SEND GPS TO NEW TRACKING API
                    // -----------------------------------------

                    fetch('/tracking/update', {

                        method: 'POST',

                        headers: {

                            'Content-Type':
                                'application/json'

                        },

                        body: JSON.stringify({

                            latitude:
                                latitude,

                            longitude:
                                longitude,

                            speed:
                                speed

                        })

                    })

                    .then(function (response) {

                        return response.json();

                    })

                    .then(function (data) {

                        console.log(
                            'Tracking update response:',
                            data
                        );

                    })

                    .catch(function (error) {

                        console.error(
                            'Tracking update failed:',
                            error
                        );

                        statusText.textContent =
                            'Server Update Failed';

                    });

                },


                function (error) {

                    console.error(
                        'GPS watcher error:',
                        error
                    );

                    statusText.textContent =
                        'GPS Error';

                },


                {

                    enableHighAccuracy:
                        true,

                    timeout:
                        15000,

                    maximumAge:
                        0

                }

            );

    }


    // -----------------------------------------
    // STOP LOCATION SHARING
    // -----------------------------------------

    if (stopBtn) {

        stopBtn.addEventListener(
            'click',
            function () {

                if (watchId !== null) {

                    navigator.geolocation.clearWatch(
                        watchId
                    );

                    watchId = null;

                }

                statusText.textContent =
                    'GPS Stopped';

                startBtn.disabled =
                    false;

                console.log(
                    'GPS location sharing stopped'
                );

            }
        );

    }

});
</script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script src="/js/script.js"></script>

</body>
</html>