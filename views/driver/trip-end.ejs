<%- include('../partials/header', {
    pageTitle: 'End Journey',
    pageCss: []
}) %>

<div class="app-shell">

<%- include('../partials/sidebar',{
currentPage:'trip-end'
}) %>

<%- include('../partials/navbar',{
pageLabel:'End Journey'
}) %>

<div class="app-main">

<main class="main-content">

<div class="container py-5">

<div class="row justify-content-center">

<div class="col-lg-6">

<div class="card shadow-sm border-0">

<div class="card-body text-center p-5">

<i class="bi bi-stop-circle-fill text-danger"
style="font-size:70px;"></i>

<h2 class="mt-3">
End Current Journey
</h2>

<p class="text-muted mb-4">
This will stop GPS sharing for students and administrators.
</p>

<button
id="endBtn"
class="btn btn-danger btn-lg">

<i class="bi bi-stop-fill"></i>

End Journey

</button>

<div id="message" class="mt-4"></div>

</div>

</div>

</div>

</div>

</div>

</main>

<%- include('../partials/footer') %>

</div>

</div>

<script>

const endBtn=document.getElementById("endBtn");

endBtn.addEventListener("click",async()=>{

endBtn.disabled=true;

endBtn.innerHTML=
'<span class="spinner-border spinner-border-sm me-2"></span>Ending...';

try{

const response=await fetch("/tracking/stop",{
method:"POST"
});

const data=await response.json();

if(data.success){

window.location.replace("/driver/trip-start");

}else{

endBtn.disabled=false;

endBtn.innerHTML=
'<i class="bi bi-stop-fill"></i> End Journey';

document.getElementById("message").innerHTML=`
<div class="alert alert-danger">
${data.message}
</div>`;

}

}catch(error){

console.error(error);

endBtn.disabled=false;

endBtn.innerHTML=
'<i class="bi bi-stop-fill"></i> End Journey';

document.getElementById("message").innerHTML=`
<div class="alert alert-danger">
Unable to contact the server.
</div>`;

}

});

</script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/script.js"></script>

</body>
</html>