<%- include('../partials/header', {
    pageTitle: 'Start Trip',
    pageCss: []
}) %>

<div class="app-shell">

    <%- include('../partials/sidebar', {
        currentPage: 'trip-start'
    }) %>

    <%- include('../partials/navbar', {
        pageLabel: 'Start Trip'
    }) %>

    <div class="app-main">

        <main class="main-content">

            <div class="container py-4">

                <div class="row justify-content-center">

                    <div class="col-lg-7">

                        <div class="card shadow-sm border-0">

                            <div class="card-body text-center p-5">

                                <i class="bi bi-bus-front-fill text-primary"
                                   style="font-size:70px;"></i>

                                <h2 class="mt-3">
                                    Start Your Journey
                                </h2>

                                <% if (bus) { %>

                                    <p class="text-muted mb-4">

                                        <strong>Bus:</strong>
                                        <%= bus.bus_number %>

                                        <br>

                                        <strong>Route:</strong>
                                        <%= bus.route_name || 'Not Assigned' %>

                                    </p>

                                    <% if (activeJourney) { %>

                                        <div class="alert alert-success">

                                            <i class="bi bi-check-circle-fill"></i>

                                            Journey already running.

                                        </div>

                                        <a
                                            href="/driver/live-location"
                                            class="btn btn-primary btn-lg">

                                            <i class="bi bi-geo-alt-fill"></i>

                                            Open Live Location

                                        </a>

                                    <% } else { %>

                                        <button
                                            id="startBtn"
                                            class="btn btn-success btn-lg">

                                            <i class="bi bi-play-fill"></i>

                                            Start Journey

                                        </button>

                                    <% } %>

                                <% } else { %>

                                    <div class="alert alert-warning">

                                        No bus is assigned to your account.

                                    </div>

                                <% } %>

                                <div
                                    id="message"
                                    class="mt-4">
                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </main>

        <%- include('../partials/footer') %>

    </div>

</div>

<script>

const startBtn = document.getElementById("startBtn");

if(startBtn){

    startBtn.addEventListener("click", async ()=>{

        startBtn.disabled = true;

        startBtn.innerHTML =
            `<span class="spinner-border spinner-border-sm me-2"></span>Starting...`;

        try{

            const response = await fetch("/tracking/start",{
                method:"POST"
            });

            const data = await response.json();

            if(data.success){

                window.location.replace("/driver/live-location");

            }else{

                startBtn.disabled = false;

                startBtn.innerHTML =
                    `<i class="bi bi-play-fill"></i> Start Journey`;

                document.getElementById("message").innerHTML = `
                    <div class="alert alert-danger">
                        ${data.message}
                    </div>`;
            }

        }catch(err){

            console.error(err);

            startBtn.disabled = false;

            startBtn.innerHTML =
                `<i class="bi bi-play-fill"></i> Start Journey`;

            document.getElementById("message").innerHTML = `
                <div class="alert alert-danger">
                    Server connection failed.
                </div>`;
        }

    });

}

</script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/script.js"></script>

</body>
</html>