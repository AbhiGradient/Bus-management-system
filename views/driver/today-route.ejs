<%- include('../partials/header',{
pageTitle:'Route Map',
pageCss:[]
}) %>

<link rel="stylesheet"
href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>

<style>

#map{
height:550px;
border-radius:15px;
}

.stop-card{
border-left:5px solid #0d6efd;
margin-bottom:12px;
}

</style>

<div class="app-shell">

<%- include('../partials/sidebar',{
currentPage:'route-map'
}) %>

<%- include('../partials/navbar',{
pageLabel:'Route Map'
}) %>

<div class="app-main">

<main class="main-content">

<div class="mb-4">

<h3>

<i class="bi bi-signpost-2-fill text-primary"></i>

Bus Route Map

</h3>

<p class="text-muted">

View your complete bus route and all pickup stops.

</p>

</div>

<% if(!route){ %>

<div class="alert alert-warning">

No route has been assigned to your bus yet.

</div>

<% } else { %>

<div class="row">

<div class="col-lg-8">

<div class="card p-3">

<div id="map"></div>

</div>

</div>

<div class="col-lg-4">

<div class="card p-3">

<h5>

<%= route.route_name %>

</h5>

<hr>

<% stops.forEach(function(stop){ %>

<div class="card stop-card p-3">

<strong>

<%= stop.stop_order %>.
<%= stop.stop_name %>

</strong>

<small class="text-muted d-block">

<%= stop.latitude %>,
<%= stop.longitude %>

</small>

</div>

<% }) %>

</div>

</div>

</div>

<% } %>

</main>

<%- include('../partials/footer') %>

</div>

</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script>

const stops=<%- JSON.stringify(stops||[]) %>;

if(stops.length){

const map=L.map("map").setView(

[
Number(stops[0].latitude),
Number(stops[0].longitude)
],

13

);

L.tileLayer(

"https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",

{

maxZoom:19,

attribution:"© OpenStreetMap"

}

).addTo(map);

const points=[];

stops.forEach(stop=>{

const lat=Number(stop.latitude);

const lng=Number(stop.longitude);

points.push([lat,lng]);

L.marker([lat,lng])

.addTo(map)

.bindPopup(

`<strong>${stop.stop_name}</strong><br>Stop ${stop.stop_order}`

);

});

L.polyline(points,{

weight:5

}).addTo(map);

map.fitBounds(points);

}

</script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script src="/js/script.js"></script>

</body>
</html>