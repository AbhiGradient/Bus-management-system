<%- include('../partials/header', {
pageTitle: 'Manage Drivers',
pageCss: []
}) %>

<div class="app-shell">

  <!-- Sidebar -->

<%- include('../partials/sidebar', {
currentPage: 'drivers'
}) %>

  <!-- Navbar -->

<%- include('../partials/navbar', {
pageLabel: 'Manage Drivers'
}) %>

  <!-- Main Application Area -->

  <div class="app-main">

```
<main class="main-content">


  <!-- Page Header -->

  <div class="d-flex justify-content-between align-items-center mb-3">

    <h3>

      <i class="bi bi-person-badge-fill"></i>

      Manage Drivers

    </h3>


    <button
      type="button"
      class="btn btn-primary"
      data-bs-toggle="modal"
      data-bs-target="#addDriverModal">

      <i class="bi bi-person-plus"></i>

      Add Driver

    </button>

  </div>



  <!-- Drivers Table -->

  <div class="card p-3">

    <div class="table-responsive">

      <table class="table table-hover align-middle">


        <thead>

          <tr>

            <th>#</th>

            <th>Name</th>

            <th>Email</th>

            <th>Phone</th>

            <th>Assigned Bus</th>

            <th>Route</th>

            <th>Status</th>

            <th class="text-end">
              Actions
            </th>

          </tr>

        </thead>



        <tbody>


          <% if (drivers.length === 0) { %>


            <tr>

              <td
                colspan="8"
                class="text-center text-muted py-3">

                No drivers added yet.

              </td>

            </tr>


          <% } else { %>


            <% drivers.forEach((d, i) => { %>


              <tr>


                <!-- Serial Number -->

                <td>

                  <%= i + 1 %>

                </td>



                <!-- Driver Name -->

                <td>

                  <strong>

                    <%= d.name %>

                  </strong>

                </td>



                <!-- Email -->

                <td>

                  <%= d.email %>

                </td>



                <!-- Phone -->

                <td>

                  <%= d.phone || '—' %>

                </td>



                <!-- Assigned Bus -->

                <td>

                  <%= d.bus_number || '—' %>

                </td>



                <!-- Route -->

                <td>

                  <%= d.route_name || '—' %>

                </td>



                <!-- Status -->

                <td>


                  <span
                    class="badge <%= d.bus_status === 'active' ? 'bg-success' : 'bg-secondary' %>">

                    <%= d.bus_status || 'unassigned' %>

                  </span>


                </td>



                <!-- Actions -->

                <td class="text-end">


                  <!-- Edit Button -->

                  <button
                    type="button"
                    class="action-btn action-btn-edit"
                    data-bs-toggle="modal"
                    data-bs-target="#editDriverModal<%= d.id %>"
                    title="Edit Driver">

                    <i class="bi bi-pencil-square"></i>

                    <span>
                      Edit
                    </span>

                  </button>



                  <!-- Delete Button -->

                  <form
                    action="/admin/drivers/<%= d.id %>?_method=DELETE"
                    method="POST"
                    class="d-inline confirm-delete">


                    <button
                      type="submit"
                      class="action-btn action-btn-delete"
                      title="Delete Driver">

                      <i class="bi bi-trash3"></i>

                      <span>
                        Delete
                      </span>

                    </button>


                  </form>


                </td>


              </tr>


            <% }) %>


          <% } %>


        </tbody>


      </table>

    </div>

  </div>


</main>


<!-- Footer -->

<%- include('../partials/footer') %>
```

  </div>

</div>

<!-- ========================================================= -->

<!-- EDIT DRIVER MODALS                                        -->

<!-- IMPORTANT: These are outside the table and tbody          -->

<!-- ========================================================= -->

<% drivers.forEach(d => { %>

  <div
    class="modal fade"
    id="editDriverModal<%= d.id %>"
    tabindex="-1"
    aria-labelledby="editDriverModalLabel<%= d.id %>"
    aria-hidden="true">

```
<div class="modal-dialog">


  <form
    action="/admin/drivers/<%= d.id %>?_method=PUT"
    method="POST"
    class="modal-content">


    <!-- Modal Header -->

    <div class="modal-header">


      <h5
        class="modal-title"
        id="editDriverModalLabel<%= d.id %>">

        Edit Driver

      </h5>


      <button
        type="button"
        class="btn-close"
        data-bs-dismiss="modal"
        aria-label="Close">
      </button>


    </div>



    <!-- Modal Body -->

    <div class="modal-body">


      <!-- Full Name -->

      <div class="mb-2">

        <label class="form-label">

          Full Name

        </label>


        <input
          type="text"
          name="name"
          class="form-control"
          value="<%= d.name %>"
          required>


      </div>



      <!-- Email -->

      <div class="mb-2">

        <label class="form-label">

          Email

        </label>


        <input
          type="email"
          name="email"
          class="form-control"
          value="<%= d.email %>"
          required>


      </div>



      <!-- Phone -->

      <div class="mb-2">

        <label class="form-label">

          Phone

        </label>


        <input
          type="text"
          name="phone"
          class="form-control"
          value="<%= d.phone || '' %>">


      </div>



      <!-- Assign Bus -->

      <div class="mb-2">

        <label class="form-label">

          Assign Bus

        </label>


        <select
          name="bus_id"
          class="form-select">


          <option value="">

            -- Unassigned --

          </option>


          <% buses.forEach(b => { %>


            <option
              value="<%= b.id %>"
              <%= String(d.bus_id) === String(b.id) ? 'selected' : '' %>>


              <%= b.bus_number %>

              —

              <%= b.route_name %>


            </option>


          <% }) %>


        </select>


      </div>


    </div>



    <!-- Modal Footer -->

    <div class="modal-footer">


      <button
        type="button"
        class="btn btn-secondary"
        data-bs-dismiss="modal">

        Cancel

      </button>


      <button
        type="submit"
        class="btn btn-primary">

        Save Changes

      </button>


    </div>


  </form>


</div>
```

  </div>

<% }) %>

