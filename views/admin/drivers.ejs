<!-- ADD DRIVER MODAL                                          -->

<!-- ========================================================= -->

<div
  class="modal fade"
  id="addDriverModal"
  tabindex="-1"
  aria-labelledby="addDriverModalLabel"
  aria-hidden="true">

  <div class="modal-dialog">

```
<form
  action="/admin/drivers"
  method="POST"
  class="modal-content">


  <!-- Modal Header -->

  <div class="modal-header">


    <h5
      class="modal-title"
      id="addDriverModalLabel">

      Add New Driver

    </h5>


    <button
      type="button"
      class="btn-close"
      data-bs-dismiss="modal"
      aria-label="Close">
    </button>


  </div>



  <!-- Modal Body -->

  <div class="modal-body">


    <!-- Full Name -->

    <div class="mb-2">

      <label class="form-label">

        Full Name

      </label>


      <input
        type="text"
        name="name"
        class="form-control"
        placeholder="Enter driver's full name"
        required>


    </div>



    <!-- Email -->

    <div class="mb-2">

      <label class="form-label">

        Email

      </label>


      <input
        type="email"
        name="email"
        class="form-control"
        placeholder="driver@example.com"
        required>


    </div>



    <!-- Phone -->

    <div class="mb-2">

      <label class="form-label">

        Phone

      </label>


      <input
        type="text"
        name="phone"
        class="form-control"
        placeholder="Enter phone number">


    </div>



    <!-- Password -->

    <div class="mb-2">

      <label class="form-label">

        Password

      </label>


      <input
        type="password"
        name="password"
        class="form-control"
        placeholder="Default: driver123">


    </div>



    <!-- Assign Bus -->

    <div class="mb-2">

      <label class="form-label">

        Assign Bus

      </label>


      <select
        name="bus_id"
        class="form-select">


        <option value="">

          -- Unassigned --

        </option>


        <% buses.forEach(b => { %>


          <option value="<%= b.id %>">

            <%= b.bus_number %>

            —

            <%= b.route_name %>

          </option>


        <% }) %>


      </select>


    </div>


  </div>



  <!-- Modal Footer -->

  <div class="modal-footer">


    <button
      type="button"
      class="btn btn-secondary"
      data-bs-dismiss="modal">

      Cancel

    </button>


    <button
      type="submit"
      class="btn btn-primary">

      Add Driver

    </button>


  </div>


</form>
```

