<%- include('../partials/header', {
  pageTitle: 'Live Tracking - Admin',
  pageCss: []
}) %>

<div class="app-shell">

  <%- include('../partials/sidebar', {
    currentPage: 'tracking'
  }) %>

  <%- include('../partials/navbar', {
    pageLabel: 'Live Tracking'
  }) %>

  <div class="app-main">
    <main class="main-content">

      <div class="d-flex justify-content-between align-items-center mb-3">
        <h3>
          <i class="bi bi-grid-3x3-gap-fill"></i>
          Live Tracking
        </h3>
      </div>

      <!-- Bus Selector -->
      <div class="card p-3 mb-3">
        <form action="/admin/live-tracking" method="GET" class="row g-2 align-items-end">

          <div class="col-md-5">
            <label class="form-label">Select Bus to </label>
            <select
              name="bus_id"
              class="form-select"
              onchange="this.form.submit()">

              <option value="">-- Choose a bus --</option>

              <% buses.forEach(b => { %>
                <option
                  value="<%= b.id %>"
                  <%= (selectedBus && selectedBus.id === b.id) ? 'selected' : '' %>>
                  <%= b.bus_number %> — <%= b.route_name %>
                </option>
              <% }) %>

            </select>
          </div>

          <div class="col-md-3">
            <button type="submit" class="btn btn-primary">
              <i class="bi bi-search"></i>
              View Bus to Track
            </button>
          </div>

        </form>
      </div>

      <% if (!selectedBus) { %>

        <div class="card p-4 text-center text-muted">
          Select a bus above to view its seat allocation.
        </div>

      <% } else { %>

        <div class="row g-3 mb-3">

    <div class="col-md-4">
        <div class="card p-3 text-center">
            <div class="text-muted small">Bus Number</div>
            <h4><%= selectedBus.bus_number %></h4>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card p-3 text-center">
            <div class="text-muted small">Route</div>
            <h6><%= selectedBus.route_name %></h6>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card p-3 text-center">
            <div class="text-muted small">Status</div>
            <span class="badge bg-success">
                Live Tracking
            </span>
        </div>
    </div>

</div>

        <!-- Driver Details -->
        <div class="card p-3 mb-3">
          <div class="card-title-row mb-3">
            <i class="bi bi-person-badge-fill"></i>
            <h5>Driver Details</h5>
          </div>

          <% if (selectedBus.driver_name) { %>
            <div class="driver-details-row">
              <div class="driver-avatar">
                <i class="bi bi-person-vcard-fill"></i>
              </div>
              <div class="driver-info">
                <div class="driver-name"><%= selectedBus.driver_name %></div>
                <div class="driver-meta">
                  <span>
                    <i class="bi bi-telephone-fill"></i>
                    <%= selectedBus.driver_phone || 'Not available' %>
                  </span>
                  <span>
                    <i class="bi bi-bus-front-fill"></i>
                    <%= selectedBus.bus_number %>
                  </span>
                </div>
              </div>
              <span class="badge-status ms-auto">On Duty</span>
            </div>
          <% } else { %>
            <div class="driver-details-row driver-unassigned">
              <div class="driver-avatar driver-avatar-empty">
                <i class="bi bi-person-x-fill"></i>
              </div>
              <div class="driver-info">
                <div class="driver-name text-muted">No Driver Assigned</div>
                <div class="driver-meta">
                  <span>This bus currently has no driver linked to it.</span>
                </div>
              </div>
            </div>
          <% } %>
        </div>
        <!-- Live Map -->
        <div class="card p-3 mt-3">

          <h5 class="mb-3">
            <i class="bi bi-geo-alt-fill text-danger"></i>
            Live Bus Location
          </h5>

          <div id="map"
               style="height:500px;border-radius:12px;">
          </div>

          <div class="mt-3">

            <button
              class="btn btn-primary"
              id="refreshBtn">

              <i class="bi bi-arrow-clockwise"></i>
              Refresh Location

            </button>

          </div>

        </div>

      <% } %>

    </main>

    
  </div>

</div>
        

    </main>

    <%- include('../partials/footer') %>

  </div>
</div>

<style>
  /* Bus body container */
  .bus-layout-wrapper {
    max-width: 320px;
    margin: 0 auto;
    padding: 18px 16px 20px;
    border: 1px solid var(--line, #dee2e6);
    border-radius: 22px;
    background: var(--paper-sunk, #f4f4f4);
  }

  /* Front row: gate on left, driver on right */
  .bus-front-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 14px;
  }

  .bus-gate-icon {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    width: 40px;
    height: 40px;
    border-radius: 8px;
    background: var(--brass-soft, rgba(184,134,60,0.14));
    border: 1px dashed var(--brass, #B8863C);
    color: var(--brass, #B8863C);
    font-size: 1rem;
  }
  .bus-gate-icon small {
    font-size: 0.55rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .bus-driver-icon {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    width: 40px;
    height: 40px;
    border-radius: 8px;
    background: var(--paper-raised, #fff);
    border: 1px solid var(--line, #dee2e6);
    color: var(--ink-low, #8A9591);
    font-size: 1rem;
  }
  .bus-driver-icon small {
    font-size: 0.5rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  /* Seat grid: 2 seats | aisle | 2 seats, wraps into rows automatically */
  .seat-grid {
    display: grid;
    grid-template-columns: 48px 48px 24px 48px 48px;
    gap: 10px;
    justify-content: center;
  }

  .seat-aisle {
    width: 24px;
  }

  .seat {
    width: 48px;
    height: 48px;
    border-radius: 8px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    font-size: 0.7rem;
    color: #fff;
    cursor: default;
  }
  .seat-occupied {
    background-color: var(--bs-danger, #dc3545);
  }
  .seat-vacant {
    background-color: var(--bs-success, #198754);
  }

  /* Driver Details card */
  .driver-details-row {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .driver-avatar {
    width: 56px;
    height: 56px;
    flex-shrink: 0;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.6rem;
    color: #fff;
    background: linear-gradient(135deg, var(--pine, #1F5C4F), var(--pine-deep, #16332C));
    box-shadow: 0 8px 20px rgba(31,92,79,0.24);
  }

  .driver-avatar-empty {
    background: linear-gradient(135deg, #8A9591, #6b7570);
    box-shadow: none;
  }

  .driver-name {
    font-family: var(--font-display, 'Fraunces', serif);
    font-weight: 600;
    font-size: 1.1rem;
    color: var(--ink-hi, #1C2622);
  }

  .driver-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 4px;
    font-size: 0.85rem;
    color: var(--ink-low, #8A9591);
  }

  .driver-meta span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .driver-unassigned {
    opacity: 0.85;
  }

  @media (max-width: 480px) {
    .bus-layout-wrapper {
      max-width: 100%;
    }
    .seat-grid {
      grid-template-columns: 42px 42px 20px 42px 42px;
      gap: 8px;
    }
    .seat {
      width: 42px;
      height: 42px;
    }
    .driver-details-row {
      flex-wrap: wrap;
    }
  }
</style>
<link
rel="stylesheet"
href="https://unpkg.com/leaflet/dist/leaflet.css">

<script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>

<script>

let map =
L.map('map').setView(
    [18.5204,73.8567],
    13
);

L.tileLayer(
'https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',
{
    maxZoom:19
}
).addTo(map);

let marker=null;

async function loadLocation(){

    <% if(selectedBus){ %>

    const res =
    await fetch(
        '/tracking/bus/<%= selectedBus.id %>'
    );

    const data =
    await res.json();

    if(
        data.location
    ){

        const lat =
        Number(data.location.latitude);

        const lng =
        Number(data.location.longitude);

        if(!marker){

            marker=L.marker([lat,lng]).addTo(map);

        }else{

            marker.setLatLng([lat,lng]);

        }

        map.setView([lat,lng],16);

    }

    <% } %>

}

loadLocation();

setInterval(loadLocation,5000);

document
.getElementById('refreshBtn')
?.addEventListener(
'click',
loadLocation
);

</script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/script.js"></script>

</body>
</html>