<!-- ADD STUDENT MODAL                                         -->

<!-- ========================================================= -->

<div
  class="modal fade"
  id="addStudentModal"
  tabindex="-1"
  aria-labelledby="addStudentModalLabel"
  aria-hidden="true">

  <div class="modal-dialog">

```
<form
  action="/admin/students"
  method="POST"
  class="modal-content">


  <!-- Modal Header -->

  <div class="modal-header">

    <h5
      class="modal-title"
      id="addStudentModalLabel">

      Add New Student

    </h5>


    <button
      type="button"
      class="btn-close"
      data-bs-dismiss="modal"
      aria-label="Close">
    </button>

  </div>



  <!-- Modal Body -->

  <div class="modal-body">


    <!-- Full Name -->

    <div class="mb-2">

      <label class="form-label">
        Full Name
      </label>

      <input
        type="text"
        name="name"
        class="form-control"
        placeholder="Enter student's full name"
        required>

    </div>



    <!-- Email -->

    <div class="mb-2">

      <label class="form-label">
        Email
      </label>

      <input
        type="email"
        name="email"
        class="form-control"
        placeholder="student@example.com"
        required>

    </div>



    <!-- Phone -->

    <div class="mb-2">

      <label class="form-label">
        Phone
      </label>

      <input
        type="text"
        name="phone"
        class="form-control"
        placeholder="Enter phone number">

    </div>



    <!-- Password -->

    <div class="mb-2">

      <label class="form-label">
        Password
      </label>

      <input
        type="password"
        name="password"
        class="form-control"
        placeholder="Default: student123">

    </div>



    <!-- Roll Number -->

    <div class="mb-2">

      <label class="form-label">
        Roll No
      </label>

      <input
        type="text"
        name="roll_no"
        class="form-control"
        placeholder="Enter roll number"
        required>

    </div>



    <!-- Department -->

    <div class="mb-2">

      <label class="form-label">
        Department
      </label>

      <input
        type="text"
        name="department"
        class="form-control"
        placeholder="e.g. Computer Science">

    </div>



    <!-- Year -->

    <div class="mb-2">

      <label class="form-label">
        Year
      </label>

      <input
        type="text"
        name="year"
        class="form-control"
        placeholder="e.g. 2nd Year">

    </div>



    <!-- Address -->

    <div class="mb-2">

      <label class="form-label">
        Address
      </label>

      <textarea
        name="address"
        rows="2"
        class="form-control"
        placeholder="Enter student's address"></textarea>

    </div>


  </div>



  <!-- Modal Footer -->

  <div class="modal-footer">


    <button
      type="button"
      class="btn btn-secondary"
      data-bs-dismiss="modal">

      Cancel

    </button>


    <button
      type="submit"
      class="btn btn-primary">

      Add Student

    </button>


  </div>


</form>
```

  </div>

</div>

