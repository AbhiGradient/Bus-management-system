<%- include('../partials/header', {
pageTitle: 'Manage Students',
pageCss: []
}) %>

<div class="app-shell">

  <!-- Sidebar -->

<%- include('../partials/sidebar', {
currentPage: 'students'
}) %>

  <!-- Navbar -->

<%- include('../partials/navbar', {
pageLabel: 'Manage Students'
}) %>

  <!-- Main Application Area -->

  <div class="app-main">

```
<main class="main-content">


  <!-- Page Header -->

  <div class="d-flex justify-content-between align-items-center mb-3">

    <h3>
      <i class="bi bi-people-fill"></i>
      Manage Students
    </h3>

    <button
      type="button"
      class="btn btn-primary"
      data-bs-toggle="modal"
      data-bs-target="#addStudentModal">

      <i class="bi bi-person-plus"></i>
      Add Student

    </button>

  </div>



  <!-- Students Table -->

  <div class="card p-3">

    <div class="table-responsive">

      <table class="table table-hover align-middle">

        <thead>

          <tr>

            <th>#</th>
            <th>Name</th>
            <th>Roll No</th>
            <th>Department</th>
            <th>Year</th>
            <th>Email</th>
            <th>Bus</th>
            <th class="text-end">Actions</th>

          </tr>

        </thead>


        <tbody>


          <% if (students.length === 0) { %>

            <tr>

              <td
                colspan="8"
                class="text-center text-muted py-3">

                No students added yet.

              </td>

            </tr>

          <% } else { %>


            <% students.forEach((s, i) => { %>

              <tr>


                <!-- Serial Number -->

                <td>
                  <%= i + 1 %>
                </td>


                <!-- Student Name -->

                <td>

                  <strong>
                    <%= s.name %>
                  </strong>

                </td>


                <!-- Roll Number -->

                <td>
                  <%= s.roll_no %>
                </td>


                <!-- Department -->

                <td>
                  <%= s.department || '—' %>
                </td>


                <!-- Year -->

                <td>
                  <%= s.year || '—' %>
                </td>


                <!-- Email -->

                <td>
                  <%= s.email %>
                </td>


                <!-- Assigned Bus -->

                <td>

                  <%= s.bus_number || '—' %>

                </td>


                <!-- Actions -->

                <td class="text-end">


                  <!-- Edit Button -->

                  <button
                    type="button"
                    class="action-btn action-btn-edit"
                    data-bs-toggle="modal"
                    data-bs-target="#editStudentModal<%= s.id %>"
                    title="Edit Student">

                    <i class="bi bi-pencil-square"></i>
                    <span>Edit</span>

                  </button>



                  <!-- Delete Button -->

                  <form
                    action="/admin/students/<%= s.id %>?_method=DELETE"
                    method="POST"
                    class="d-inline confirm-delete">

                    <button
                      type="submit"
                      class="action-btn action-btn-delete"
                      title="Delete Student">

                      <i class="bi bi-trash3"></i>
                      <span>Delete</span>

                    </button>

                  </form>


                </td>


              </tr>

            <% }) %>

          <% } %>


        </tbody>

      </table>

    </div>

  </div>


</main>


<!-- Footer -->

<%- include('../partials/footer') %>
```

  </div>

</div>

<!-- ========================================================= -->

<!-- EDIT STUDENT MODALS                                       -->

<!-- IMPORTANT: These are outside the table and tbody          -->

<!-- ========================================================= -->

<% students.forEach(s => { %>

  <div
    class="modal fade"
    id="editStudentModal<%= s.id %>"
    tabindex="-1"
    aria-labelledby="editStudentModalLabel<%= s.id %>"
    aria-hidden="true">

```
<div class="modal-dialog">


  <form
    action="/admin/students/<%= s.id %>?_method=PUT"
    method="POST"
    class="modal-content">


    <!-- Modal Header -->

    <div class="modal-header">

      <h5
        class="modal-title"
        id="editStudentModalLabel<%= s.id %>">

        Edit Student

      </h5>


      <button
        type="button"
        class="btn-close"
        data-bs-dismiss="modal"
        aria-label="Close">
      </button>

    </div>



    <!-- Modal Body -->

    <div class="modal-body">


      <!-- Full Name -->

      <div class="mb-2">

        <label class="form-label">
          Full Name
        </label>

        <input
          type="text"
          name="name"
          class="form-control"
          value="<%= s.name %>"
          required>

      </div>



      <!-- Email -->

      <div class="mb-2">

        <label class="form-label">
          Email
        </label>

        <input
          type="email"
          name="email"
          class="form-control"
          value="<%= s.email %>"
          required>

      </div>



      <!-- Phone -->

      <div class="mb-2">

        <label class="form-label">
          Phone
        </label>

        <input
          type="text"
          name="phone"
          class="form-control"
          value="<%= s.phone || '' %>">

      </div>



      <!-- Roll Number -->

      <div class="mb-2">

        <label class="form-label">
          Roll No
        </label>

        <input
          type="text"
          name="roll_no"
          class="form-control"
          value="<%= s.roll_no %>"
          required>

      </div>



      <!-- Department -->

      <div class="mb-2">

        <label class="form-label">
          Department
        </label>

        <input
          type="text"
          name="department"
          class="form-control"
          value="<%= s.department || '' %>">

      </div>



      <!-- Year -->

      <div class="mb-2">

        <label class="form-label">
          Year
        </label>

        <input
          type="text"
          name="year"
          class="form-control"
          value="<%= s.year || '' %>"
          placeholder="e.g. 2nd Year">

      </div>



      <!-- Address -->

      <div class="mb-2">

        <label class="form-label">
          Address
        </label>

        <textarea
          name="address"
          rows="2"
          class="form-control"><%= s.address || '' %></textarea>

      </div>


    </div>



    <!-- Modal Footer -->

    <div class="modal-footer">


      <button
        type="button"
        class="btn btn-secondary"
        data-bs-dismiss="modal">

        Cancel

      </button>


      <button
        type="submit"
        class="btn btn-primary">

        Save Changes

      </button>


    </div>


  </form>


</div>
```

  </div>

<% }) %>

