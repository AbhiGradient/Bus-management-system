<%- include('../partials/header', {
pageTitle: 'Manage Buses',
pageCss: []
}) %>

<div class="app-shell">

  <!-- Sidebar -->

<%- include('../partials/sidebar', {
currentPage: 'buses'
}) %>

  <!-- Navbar -->

<%- include('../partials/navbar', {
pageLabel: 'Manage Buses'
}) %>

  <!-- Main Application Area -->

  <div class="app-main">

```
<main class="main-content">

  <!-- Page Header -->
  <div class="d-flex justify-content-between align-items-center mb-3">

    <h3>
      <i class="bi bi-bus-front-fill"></i>
      Manage Buses
    </h3>

    <button
      type="button"
      class="btn btn-primary"
      data-bs-toggle="modal"
      data-bs-target="#addBusModal">

      <i class="bi bi-plus-circle"></i>
      Add Bus

    </button>

  </div>


  <!-- Bus Table -->
  <div class="card p-3">

    <div class="table-responsive">

      <table class="table table-hover align-middle">

        <thead>
          <tr>
            <th>#</th>
            <th>Bus Number</th>
            <th>Route</th>
            <th>Capacity</th>
            <th>Driver</th>
            <th>Status</th>
            <th class="text-end">Actions</th>
          </tr>
        </thead>


        <tbody>

          <% if (buses.length === 0) { %>

            <tr>
              <td
                colspan="7"
                class="text-center text-muted py-3">

                No buses added yet.

              </td>
            </tr>

          <% } else { %>


            <% buses.forEach((bus, i) => { %>

              <tr>

                <!-- Serial Number -->
                <td>
                  <%= i + 1 %>
                </td>


                <!-- Bus Number -->
                <td>
                  <strong>
                    <%= bus.bus_number %>
                  </strong>
                </td>


                <!-- Route -->
                <td>
                  <%= bus.route_name %>
                </td>


                <!-- Capacity -->
                <td>
                  <%= bus.capacity %>
                </td>


                <!-- Driver -->
                <td>
                  <%= bus.driver_name || '—' %>
                </td>


                <!-- Status -->
                <td>

                  <span
                    class="badge badge-status <%= bus.status === 'active' ? 'bg-success' : 'bg-secondary' %>">

                    <%= bus.status %>

                  </span>

                </td>


                <!-- Actions -->
                <td class="text-end">

  <!-- Edit Button -->
  <button
    type="button"
    class="action-btn action-btn-edit"
    data-bs-toggle="modal"
    data-bs-target="#editBusModal<%= bus.id %>"
    title="Edit Bus">

    <i class="bi bi-pencil-square"></i>
    <span>Edit</span>

  </button>


  <!-- Delete Button -->
  <form
    action="/admin/buses/<%= bus.id %>?_method=DELETE"
    method="POST"
    class="d-inline confirm-delete">

    <button
      type="submit"
      class="action-btn action-btn-delete"
      title="Delete Bus">

      <i class="bi bi-trash3"></i>
      <span>Delete</span>

    </button>

  </form>

</td>

              </tr>

            <% }) %>

          <% } %>

        </tbody>

      </table>

    </div>

  </div>

</main>


<!-- Footer -->
<%- include('../partials/footer') %>
```

  </div>

</div>

<!-- ========================================================= -->

<!-- EDIT BUS MODALS                                           -->

<!-- IMPORTANT: These are OUTSIDE the table and tbody          -->

<!-- ========================================================= -->

<% buses.forEach(bus => { %>

  <div
    class="modal fade"
    id="editBusModal<%= bus.id %>"
    tabindex="-1"
    aria-labelledby="editBusModalLabel<%= bus.id %>"
    aria-hidden="true">

```
<div class="modal-dialog">

  <form
    action="/admin/buses/<%= bus.id %>?_method=PUT"
    method="POST"
    class="modal-content">


    <!-- Modal Header -->

    <div class="modal-header">

      <h5
        class="modal-title"
        id="editBusModalLabel<%= bus.id %>">

        Edit Bus - <%= bus.bus_number %>

      </h5>

      <button
        type="button"
        class="btn-close"
        data-bs-dismiss="modal"
        aria-label="Close">
      </button>

    </div>


    <!-- Modal Body -->

    <div class="modal-body">


      <!-- Bus Number -->

      <div class="mb-2">

        <label class="form-label">
          Bus Number
        </label>

        <input
          type="text"
          name="bus_number"
          class="form-control"
          value="<%= bus.bus_number %>"
          required>

      </div>


      <!-- Route -->

      <div class="mb-2">

        <label class="form-label">
          Route
        </label>

        <input
          type="text"
          name="route_name"
          class="form-control"
          value="<%= bus.route_name %>"
          required>

      </div>


      <!-- Capacity -->

      <div class="mb-2">

        <label class="form-label">
          Capacity
        </label>

        <input
          type="number"
          name="capacity"
          class="form-control"
          value="<%= bus.capacity %>"
          min="1"
          required>

      </div>


      <!-- Driver -->

      <div class="mb-2">

        <label class="form-label">
          Driver
        </label>

        <select
          name="driver_id"
          class="form-select">

          <option value="">
            -- Unassigned --
          </option>

          <% drivers.forEach(d => { %>

            <option
              value="<%= d.id %>"
              <%= String(bus.driver_id) === String(d.id) ? 'selected' : '' %>>

              <%= d.name %>

            </option>

          <% }) %>

        </select>

      </div>


      <!-- Status -->

      <div class="mb-2">

        <label class="form-label">
          Status
        </label>

        <select
          name="status"
          class="form-select">

          <option
            value="active"
            <%= bus.status === 'active' ? 'selected' : '' %>>

            Active

          </option>

          <option
            value="inactive"
            <%= bus.status === 'inactive' ? 'selected' : '' %>>

            Inactive

          </option>

        </select>

      </div>


    </div>


    <!-- Modal Footer -->

    <div class="modal-footer">

      <button
        type="button"
        class="btn btn-secondary"
        data-bs-dismiss="modal">

        Cancel

      </button>

      <button
        type="submit"
        class="btn btn-primary">

        Save Changes

      </button>

    </div>


  </form>

</div>
```

